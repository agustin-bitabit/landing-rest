{
  "name": "landing-rest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "test": "node --test tests/**/*.test.js",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --test tests/**/*.test.js",
    "sam:build": "sam build --use-container",
    "sam:deploy": "sam deploy",
    "sam:local": "sam local start-api"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "contentful": "^11.12.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  }
}
