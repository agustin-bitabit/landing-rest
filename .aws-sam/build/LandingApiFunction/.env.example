# Content Delivery API (Settings → API keys → Content delivery / preview token)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# Opcional
CONTENTFUL_ENVIRONMENT=master
# Content type ID en Contentful (Content model → API Identifier)
CONTENTFUL_TESTIMONIAL_CONTENT_TYPE=testimonios
# Locale del contenido (debe existir en el space)
CONTENTFUL_LOCALE=en-US

PORT=8080

# MongoDB (local y Lambda vía parámetro MongoDbUri en SAM)
MONGODB_URI=

# JWT (local y Lambda vía parámetro JwtSecret en SAM)
JWT_SECRET=

# CORS (opcional; varios orígenes separados por coma)
# CORS_ORIGIN=http://localhost:5173,https://tu-app.cloudfront.net